+  // Joint reads run here, separate from command callbacks. A command increments
+  // bus_waiters_ so the next read gives up the serial port instead of starting.
+  rclcpp::CallbackGroup::SharedPtr cb_group_joint_states_;
+  std::mutex bus_mutex_;
+  std::atomic<int> bus_waiters_{0};
+
+  class BusTicket
+  {
+public:
+    explicit BusTicket(InterbotixRobotXS & node)
+    : node_(node)
+    {
+      node_.bus_waiters_.fetch_add(1, std::memory_order_acq_rel);
+      node_.bus_mutex_.lock();
+    }
+
+    ~BusTicket()
+    {
+      node_.bus_mutex_.unlock();
+      node_.bus_waiters_.fetch_sub(1, std::memory_order_acq_rel);
+    }
+
+    BusTicket(const BusTicket &) = delete;
+    BusTicket & operator=(const BusTicket &) = delete;
+
+private:
+    InterbotixRobotXS & node_;
+  };
